# Gemini API Key (get from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=your-gemini-api-key-here

# Daytona API Key (you already have this)
DAYTONA_API_KEY=dtn_your_daytona_key_here

# Optional: Browser Use API Key (if using cloud version)
BROWSER_USE_API_KEY=your-browser-use-api-key-here

# Local app to test against
TARGET_URL=http://localhost:3000
